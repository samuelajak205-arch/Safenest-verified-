rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net - Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // properties collection rules
    match /properties/{propertyId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidId(propertyId);
      allow delete: if isSignedIn();
    }

    // rentalApplications collection rules
    match /rentalApplications/{applicationId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(applicationId);
      allow delete: if isSignedIn();
    }

    // leases collection rules
    match /leases/{leaseId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(leaseId);
      allow delete: if isSignedIn();
    }

    // inspectionBookings collection rules
    match /inspectionBookings/{bookingId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(bookingId);
      allow delete: if isSignedIn();
    }
  }
}
